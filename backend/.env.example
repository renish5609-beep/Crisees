# Copy to backend/.env and adjust. All variables are optional.
CRISEES_ENV=development
CRISEES_LOG_LEVEL=INFO
# Absolute or repo-relative path to the data directory (contains raw/ and processed/)
CRISEES_DATA_DIR=../data
# Comma-separated list of allowed browser origins
CRISEES_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for extra origins (e.g. Vercel previews)
# CRISEES_CORS_ORIGIN_REGEX=^https://crisees-.*\.vercel\.app$
CRISEES_DEFAULT_PAGE_SIZE=500
CRISEES_MAX_PAGE_SIZE=5000
# Optional free key from https://api.census.gov/data/key_signup.html
# Enables the Census Data API path; without it the pipeline uses the ACS Summary File.
CENSUS_API_KEY=

# Deployment data provisioning (see docs/DEPLOYMENT.md)
# CRISEES_DATA_URL=https://github.com/<owner>/Crisees/releases/download/data-v1/crisees-data-houston-sw-pilot-<stamp>.tar.gz
# CRISEES_DATA_SHA256=<sha256 from the .sha256 file>
# CRISEES_BUILD_DATA=0          # 1 = rebuild from public sources at start if no data
# CRISEES_OVERTURE_RELEASE=2026-11-18.0
